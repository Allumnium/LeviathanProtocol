[node name="Title" parent="Contents" index="0"]
text = "HOW TO PLAY"

[node name="Body" type="Label" parent="Contents/ContentArea" index="0"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 12
text = "Build an armed ship, press Deploy, then select a reachable node.
Your ship automatically fights 3-8 aliens and collects salvage.
Ships keep weapon range, focus weak targets, and retreat on low shields.
Drag or use WASD / arrows to pan. Mouse wheel zooms. Space follows your ship.
Salvage: blue = common, red = uncommon, green = rare.
Each alien has a 60% drop chance (65% blue, 25% red, 10% green).
Squares enter your inventory; rest 1 second after collection, then return.
Ships are repaired between deployments; defeat does not advance the map."
autowrap_mode = 2
horizontal_alignment = 1
vertical_alignment = 1
