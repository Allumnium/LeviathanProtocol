{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"description": "Shared research-bar progression and base card count; the Science flagship adds its declared bonus.",
	"properties": {
		"threshold_step": {"type": "integer", "minimum": 1, "maximum": 1000000},
		"base_options": {"type": "integer", "minimum": 1, "maximum": 3}
	},
	"required": ["threshold_step", "base_options"],
	"additionalProperties": false
}
