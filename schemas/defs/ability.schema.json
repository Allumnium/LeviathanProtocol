{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"description": "An active ability granted by equipment.",
	"properties": {
		"revision": {"$ref": "_common#/$defs/revision"},
		"display_name": {"type": "string", "minLength": 1},
		"implemented": {"type": "boolean"},
		"source_equipment_id": {"type": "string", "x-ref": "part"},
		"cooldown_seconds": {"type": "number", "minimum": 0},
		"range_units": {"type": "number", "minimum": 0},
		"radius_units": {"type": "number", "minimum": 0},
		"duration_seconds": {"type": "number", "minimum": 0},
		"target_rule": {"type": "string", "minLength": 1},
		"capstone": {"type": "boolean"},
		"cooldown_scope": {"enum": ["fleet_per_type"]},
		"clock": {"enum": ["simulation"]},
		"initial_cooldown_fraction": {"type": "number", "minimum": 0, "maximum": 1},
		"description": {"type": "string"},
		"source_research_capability": {"$ref": "_common#/$defs/key"}
	},
	"required": [
		"revision", "display_name", "implemented", "source_equipment_id", "cooldown_seconds", "duration_seconds",
		"target_rule", "capstone", "cooldown_scope", "clock", "initial_cooldown_fraction"
	],
	"additionalProperties": false
}
