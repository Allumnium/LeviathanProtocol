{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"description": "Shared encounter allocation and reward parameters.",
	"type": "object",
	"properties": {
		"revision": {
			"$ref": "_common#/$defs/revision"
		},
		"catalog": {
			"type": "array",
			"items": {
				"type": "string",
				"x-ref": "enemy_unit"
			},
			"minItems": 1
		},
		"allowed_units": {
			"type": "array",
			"items": {
				"type": "string",
				"x-ref": "enemy_unit"
			},
			"minItems": 1
		},
		"difficulty": {
			"type": "array",
			"items": {
				"type": "number",
				"exclusiveMinimum": 0
			},
			"minItems": 3,
			"maxItems": 3
		},
		"type_multipliers": {
			"type": "object",
			"properties": {
				"standard": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"elite": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"boss": {
					"type": "number",
					"exclusiveMinimum": 0
				}
			},
			"required": [
				"standard",
				"elite",
				"boss"
			],
			"additionalProperties": false
		},
		"threat_base": {
			"type": "number",
			"exclusiveMinimum": 0
		},
		"threat_growth": {
			"type": "number",
			"exclusiveMinimum": 0
		},
		"rows": {
			"type": "integer",
			"minimum": 2,
			"maximum": 24
		},
		"rank_rows": {
			"type": "integer",
			"minimum": 1
		},
		"fleet_multiplier": {
			"type": "integer",
			"minimum": 1,
			"maximum": 10
		},
		"hazard_fraction": {
			"type": "number",
			"minimum": 0,
			"exclusiveMaximum": 1
		},
		"materials": {
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": 0
			},
			"minItems": 3,
			"maxItems": 3
		},
		"material_weights": {
			"type": "array",
			"items": {
				"type": "number",
				"minimum": 0
			},
			"minItems": 4,
			"maxItems": 4
		},
		"credits_base": {
			"type": "integer",
			"minimum": 0
		},
		"credits_step": {
			"type": "integer",
			"minimum": 0
		},
		"initial_recovery_rate": {
			"type": "number",
			"exclusiveMinimum": 0,
			"maximum": 1
		}
	},
	"required": [
		"revision",
		"catalog",
		"allowed_units",
		"difficulty",
		"type_multipliers",
		"threat_base",
		"threat_growth",
		"rows",
		"rank_rows",
		"fleet_multiplier",
		"hazard_fraction",
		"materials",
		"material_weights",
		"credits_base",
		"credits_step",
		"initial_recovery_rate"
	],
	"additionalProperties": false
}
