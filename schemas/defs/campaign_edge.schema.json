{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"description": "A legacy campaign route type.",
	"properties": {
		"revision": {"$ref": "_common#/$defs/revision"},
		"display_name": {"type": "string", "minLength": 1},
		"implemented": {"type": "boolean"},
		"duration_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
		"environment_ids": {"type": "array", "items": {"type": "string", "x-ref": "environment"}, "uniqueItems": true},
		"mining_potential": {"type": "boolean"},
		"grants_rp": {"type": "boolean"},
		"surprise_aliens": {"type": "boolean"}
	},
	"required": [
		"revision", "display_name", "implemented", "duration_seconds", "environment_ids", "mining_potential",
		"grants_rp", "surprise_aliens"
	],
	"additionalProperties": false
}
