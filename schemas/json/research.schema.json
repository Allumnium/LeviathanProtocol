{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "research def",
	"type": "object",
	"description": "A research project.",
	"properties": {
		"def": {
			"const": "research",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"implemented": {
			"type": "boolean"
		},
		"cost_rp": {
			"type": "integer",
			"minimum": 0
		},
		"prerequisite_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
				"patternErrorMessage": "Use a research ID such as name or pack:name",
				"description": "ID of a research def."
			},
			"uniqueItems": true
		},
		"story_gate_ids": {
			"$ref": "_common.schema.json#/$defs/keys"
		},
		"family_id": {
			"$ref": "_common.schema.json#/$defs/optional_key"
		},
		"path_id": {
			"$ref": "_common.schema.json#/$defs/optional_key"
		},
		"exclusion_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
				"patternErrorMessage": "Use a research ID such as name or pack:name",
				"description": "ID of a research def."
			},
			"uniqueItems": true
		},
		"grants": {
			"type": "object",
			"description": "What completing the project unlocks.",
			"properties": {
				"equipment_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
						"patternErrorMessage": "Use a part ID such as name or pack:name",
						"description": "ID of a part def."
					},
					"uniqueItems": true
				},
				"ranks": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"equipment_id": {
								"type": "string",
								"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
								"patternErrorMessage": "Use a part ID such as name or pack:name",
								"description": "ID of a part def."
							},
							"rank": {
								"type": "integer",
								"minimum": 1
							}
						},
						"required": [
							"equipment_id",
							"rank"
						],
						"additionalProperties": false
					}
				},
				"ability_ids": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
						"patternErrorMessage": "Use an ability ID such as name or pack:name",
						"description": "ID of an ability def."
					},
					"uniqueItems": true
				},
				"modifiers": {
					"type": "array",
					"items": {
						"type": "object",
						"description": "A research modifier.",
						"properties": {
							"id": {
								"$ref": "_common.schema.json#/$defs/key"
							},
							"value": {
								"type": [
									"number",
									"boolean"
								]
							},
							"values": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"refill_existing": {
								"type": "boolean"
							}
						},
						"required": [
							"id"
						],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"equipment_ids",
				"ranks",
				"ability_ids",
				"modifiers"
			],
			"additionalProperties": false
		},
		"equipment_capabilities_any": {
			"$ref": "_common.schema.json#/$defs/keys"
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"implemented",
			"cost_rp",
			"prerequisite_ids",
			"story_gate_ids",
			"family_id",
			"path_id",
			"exclusion_ids",
			"grants"
		]
	}
}
