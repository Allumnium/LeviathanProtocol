{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "enemy_unit def",
	"description": "An enemy body, its priced rank tiers and art.",
	"type": "object",
	"properties": {
		"def": {
			"const": "enemy_unit",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"role": {
			"enum": [
				"scout",
				"fighter",
				"sentinel",
				"support",
				"chrysalis",
				"warden",
				"pylon",
				"drone"
			]
		},
		"kind": {
			"enum": [
				"ship",
				"organ",
				"craft"
			]
		},
		"art": {
			"type": "string",
			"description": "Pack-relative image file."
		},
		"tier_art": {
			"type": "string",
			"description": "Pack-relative image file."
		},
		"tier_art_scale": {
			"type": "number",
			"exclusiveMinimum": 0
		},
		"cost": {
			"type": "number",
			"minimum": 0
		},
		"stats": {
			"type": "object",
			"properties": {
				"shields": {
					"type": "number",
					"minimum": 0
				},
				"integrity": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"weight": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"thrust": {
					"type": "number",
					"minimum": 0
				},
				"collision_radius": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"weapons": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"minLength": 1
							},
							"interval": {
								"type": "number",
								"exclusiveMinimum": 0
							},
							"damage": {
								"type": "number",
								"exclusiveMinimum": 0
							},
							"count": {
								"type": "integer",
								"minimum": 1
							},
							"range": {
								"type": "number",
								"exclusiveMinimum": 0
							},
							"projectile": {
								"type": "boolean"
							},
							"interceptable": {
								"type": "boolean"
							}
						},
						"required": [
							"name",
							"interval",
							"damage",
							"count",
							"range",
							"projectile",
							"interceptable"
						],
						"additionalProperties": false
					},
					"minItems": 1
				}
			},
			"required": [
				"shields",
				"integrity",
				"weight",
				"thrust",
				"collision_radius",
				"weapons"
			],
			"additionalProperties": false
		},
		"tiers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"rank": {
						"type": "integer",
						"minimum": 0,
						"maximum": 2
					},
					"cost": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"hull": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"damage": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"weight": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"thrust": {
						"type": "number",
						"exclusiveMinimum": 0
					}
				},
				"required": [
					"rank",
					"cost",
					"hull",
					"damage",
					"weight",
					"thrust"
				],
				"additionalProperties": false
			},
			"minItems": 1,
			"maxItems": 3
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"role",
			"kind",
			"art",
			"tier_art",
			"tier_art_scale",
			"cost",
			"stats",
			"tiers"
		]
	}
}
