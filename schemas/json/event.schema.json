{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "event def",
	"type": "object",
	"description": "A story event. Within a trigger, the first ready event in file order fires.",
	"properties": {
		"def": {
			"const": "event",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"trigger": {
			"enum": [
				"distance",
				"zone",
				"arrival",
				"start",
				"departure",
				"story"
			]
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"text": {
			"type": "string",
			"minLength": 1
		},
		"art": {
			"type": "string",
			"description": "Pack-relative image file."
		},
		"location_id": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use a location ID such as name or pack:name",
			"description": "ID of a location def."
		},
		"destination_id": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use a location ID such as name or pack:name",
			"description": "ID of a location def."
		},
		"distance_nu": {
			"type": "number",
			"minimum": 0
		},
		"position": {
			"$ref": "_common.schema.json#/$defs/vec2"
		},
		"radius": {
			"type": "number",
			"exclusiveMinimum": 0,
			"maximum": 1000
		},
		"requires_flag": {
			"$ref": "_common.schema.json#/$defs/flag"
		},
		"requires_flags": {
			"$ref": "_common.schema.json#/$defs/flags"
		},
		"excludes_flags": {
			"$ref": "_common.schema.json#/$defs/flags"
		},
		"text_variants": {
			"type": "array",
			"items": {
				"type": "object",
				"description": "Replaces the event text when its conditions match.",
				"properties": {
					"text": {
						"type": "string",
						"minLength": 1
					},
					"chassis": {
						"type": "string",
						"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
						"patternErrorMessage": "Use a chassis ID such as name or pack:name",
						"description": "ID of a chassis def."
					},
					"capability": {
						"$ref": "_common.schema.json#/$defs/key"
					},
					"requires_flags": {
						"$ref": "_common.schema.json#/$defs/flags"
					},
					"excludes_flags": {
						"$ref": "_common.schema.json#/$defs/flags"
					}
				},
				"required": [
					"text"
				],
				"additionalProperties": false
			}
		},
		"options": {
			"type": "array",
			"items": {
				"type": "object",
				"description": "A choice offered by the event.",
				"properties": {
					"id": {
						"$ref": "_common.schema.json#/$defs/key"
					},
					"label": {
						"type": "string",
						"minLength": 1
					},
					"effects": {
						"type": "object",
						"description": "What choosing the option does.",
						"properties": {
							"credits": {
								"type": "integer"
							},
							"fuel": {
								"type": "number"
							},
							"research": {
								"type": "number",
								"minimum": 0
							},
							"hull_damage": {
								"type": "number",
								"minimum": 0,
								"maximum": 0.5
							},
							"missiles": {
								"type": "integer",
								"minimum": 0
							},
							"requires_credits": {
								"type": "integer",
								"minimum": 0
							},
							"requires_fuel": {
								"type": "number",
								"minimum": 0
							},
							"flag": {
								"$ref": "_common.schema.json#/$defs/flag"
							},
							"flags": {
								"$ref": "_common.schema.json#/$defs/flags"
							},
							"detour": {
								"type": "boolean"
							},
							"complete": {
								"type": "boolean"
							},
							"discover": {
								"type": "array",
								"items": {
									"type": "string",
									"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
									"patternErrorMessage": "Use a location ID such as name or pack:name",
									"description": "ID of a location def."
								},
								"uniqueItems": true
							},
							"rescue_ship": {
								"type": "string",
								"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
								"patternErrorMessage": "Use a chassis ID such as name or pack:name",
								"description": "ID of a chassis def."
							},
							"combat": {
								"type": "object",
								"description": "Starts a battle.",
								"properties": {
									"template": {
										"enum": [
											"patrol",
											"elite",
											"relay_defense",
											"pylon_escort",
											"bastion_warden"
										]
									},
									"row": {
										"type": "integer",
										"minimum": 1,
										"maximum": 24
									},
									"strength": {
										"type": "number",
										"minimum": 1,
										"maximum": 10
									},
									"credits": {
										"type": "integer",
										"minimum": 0
									},
									"research": {
										"type": "number",
										"minimum": 0
									},
									"fuel": {
										"type": "number"
									},
									"missiles": {
										"type": "integer",
										"minimum": 0
									},
									"asteroids": {
										"type": "integer",
										"minimum": 0,
										"maximum": 3
									},
									"nebula": {
										"type": "boolean"
									},
									"rescue_ship": {
										"type": "string",
										"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
										"patternErrorMessage": "Use a chassis ID such as name or pack:name",
										"description": "ID of a chassis def."
									},
									"victory_flags": {
										"$ref": "_common.schema.json#/$defs/flags"
									},
									"withdrawal_flags": {
										"$ref": "_common.schema.json#/$defs/flags"
									}
								},
								"required": [
									"template",
									"row"
								],
								"additionalProperties": false
							}
						},
						"additionalProperties": false
					}
				},
				"required": [
					"id",
					"label"
				],
				"additionalProperties": false
			},
			"minItems": 1,
			"maxItems": 4
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"trigger",
			"title",
			"text",
			"options"
		]
	}
}
