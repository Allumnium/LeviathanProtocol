{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "economy def",
	"type": "object",
	"description": "Trade fares, ammunition purchases, refueling and towing prices.",
	"properties": {
		"def": {
			"const": "economy",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"passenger_fare": {
			"type": "integer",
			"minimum": 1,
			"maximum": 1000000
		},
		"passenger_death_fee": {
			"type": "integer",
			"minimum": 0,
			"maximum": 1000000
		},
		"missile_pack_size": {
			"type": "integer",
			"minimum": 1,
			"maximum": 1000000
		},
		"missile_pack_price": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647
		},
		"fuel_unit_price": {
			"type": "number",
			"exclusiveMinimum": 0,
			"maximum": 1000000
		},
		"tow_base_fee": {
			"type": "number",
			"minimum": 0,
			"maximum": 1000000
		},
		"tow_per_nav_unit": {
			"type": "number",
			"minimum": 0,
			"maximum": 1000000
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"passenger_fare",
			"passenger_death_fee",
			"missile_pack_size",
			"missile_pack_price",
			"fuel_unit_price",
			"tow_base_fee",
			"tow_per_nav_unit"
		]
	}
}
