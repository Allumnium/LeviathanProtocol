{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "campaign_node def",
	"type": "object",
	"description": "A legacy campaign map node type.",
	"properties": {
		"def": {
			"const": "campaign_node",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"implemented": {
			"type": "boolean"
		},
		"inhabited_default": {
			"type": "boolean"
		},
		"combat": {
			"type": "boolean"
		},
		"goods_grade_id": {
			"anyOf": [
				{
					"const": ""
				},
				{
					"type": "string",
					"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
					"patternErrorMessage": "Use a goods ID such as name or pack:name",
					"description": "ID of a goods def."
				}
			]
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"implemented",
			"inhabited_default",
			"combat",
			"goods_grade_id"
		]
	}
}
