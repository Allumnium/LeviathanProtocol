{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "run_start def",
	"type": "object",
	"description": "Starting resources, fitted fleet and dock; composed into scenario recipes in P6.",
	"properties": {
		"def": {
			"const": "run_start",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"fleet": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use a fleet_package ID such as name or pack:name",
			"description": "ID of a fleet_package def."
		},
		"location": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use a location ID such as name or pack:name",
			"description": "ID of a location def."
		},
		"credits": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647
		},
		"missiles": {
			"type": "integer",
			"minimum": 0,
			"maximum": 2147483647
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"fleet",
			"location",
			"credits",
			"missiles"
		]
	}
}
