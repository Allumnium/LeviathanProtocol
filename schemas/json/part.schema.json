{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "part def",
	"type": "object",
	"description": "Part identity shared by equipment ranks: recipe, abilities and rank recipes.",
	"properties": {
		"def": {
			"const": "part",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"implemented": {
			"type": "boolean"
		},
		"type_id": {
			"type": "integer",
			"minimum": 0
		},
		"enum_key": {
			"type": "string",
			"minLength": 1
		},
		"recipe": {
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"capstone": {
			"type": "boolean"
		},
		"regular_slots_only": {
			"type": "boolean"
		},
		"offensive_capstone": {
			"type": "boolean"
		},
		"ability_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
				"patternErrorMessage": "Use an ability ID such as name or pack:name",
				"description": "ID of an ability def."
			},
			"uniqueItems": true
		},
		"ranks": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"rank": {
						"type": "integer",
						"minimum": 1
					},
					"recipe": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"rank",
					"recipe"
				],
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"implemented",
			"type_id",
			"enum_key",
			"recipe",
			"description",
			"capstone",
			"regular_slots_only",
			"offensive_capstone",
			"ability_ids",
			"ranks"
		]
	}
}
