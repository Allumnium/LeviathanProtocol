{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "campaign_edge def",
	"type": "object",
	"description": "A legacy campaign route type.",
	"properties": {
		"def": {
			"const": "campaign_edge",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"implemented": {
			"type": "boolean"
		},
		"duration_seconds": {
			"type": "array",
			"items": {
				"type": "number",
				"minimum": 0
			},
			"minItems": 2,
			"maxItems": 2
		},
		"environment_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
				"patternErrorMessage": "Use an environment ID such as name or pack:name",
				"description": "ID of an environment def."
			},
			"uniqueItems": true
		},
		"mining_potential": {
			"type": "boolean"
		},
		"grants_rp": {
			"type": "boolean"
		},
		"surprise_aliens": {
			"type": "boolean"
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"implemented",
			"duration_seconds",
			"environment_ids",
			"mining_potential",
			"grants_rp",
			"surprise_aliens"
		]
	}
}
