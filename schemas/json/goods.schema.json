{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "goods def",
	"type": "object",
	"description": "A trade goods grade.",
	"properties": {
		"def": {
			"const": "goods",
			"description": "Def type; optional when the file sets it."
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"patternErrorMessage": "Use lowercase letters, digits and _, with @ or / for variants"
		},
		"parent": {
			"type": "string",
			"pattern": "^([a-z][a-z0-9_]{1,63}:)?[a-z][a-z0-9_]*([@/][a-z0-9_]+)*$",
			"description": "Def to inherit fields from."
		},
		"abstract": {
			"type": "boolean",
			"description": "A template for other defs; never used directly."
		},
		"notes": {
			"type": "string",
			"description": "Designer notes; ignored by the game."
		},
		"revision": {
			"$ref": "_common.schema.json#/$defs/revision"
		},
		"display_name": {
			"type": "string",
			"minLength": 1
		},
		"implemented": {
			"type": "boolean"
		},
		"unit_value": {
			"type": "integer",
			"minimum": 0
		},
		"freeze_value_on_load": {
			"type": "boolean"
		},
		"settlement_order": {
			"$ref": "_common.schema.json#/$defs/keys"
		}
	},
	"additionalProperties": false,
	"required": [
		"id"
	],
	"if": {
		"anyOf": [
			{
				"required": [
					"parent"
				]
			},
			{
				"properties": {
					"abstract": {
						"const": true
					}
				},
				"required": [
					"abstract"
				]
			}
		]
	},
	"else": {
		"required": [
			"revision",
			"display_name",
			"implemented",
			"unit_value",
			"freeze_value_on_load",
			"settlement_order"
		]
	}
}
