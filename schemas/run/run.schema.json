{
	"type": "object",
	"properties": {
		"meta": {
			"type": "object",
			"properties": {
				"format": {"const": "leviathan_run"}, "version": {"const": 1},
				"id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
				"seed": {"type": "string", "pattern": "^[0-9]+$"},
				"difficulty": {"type": "integer", "minimum": 0, "maximum": 2},
				"scenario": {"type": "string", "minLength": 1}, "mode": {"const": "story"},
				"content_hash": {"type": "string", "minLength": 16},
				"packs": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 2}, "version": {"type": "string", "minLength": 1}, "hash": {"type": "string", "minLength": 64, "maxLength": 64}}, "required": ["id", "version", "hash"], "additionalProperties": false}},
				"content_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
			},
			"required": ["format", "version", "id", "seed", "difficulty", "scenario", "mode", "content_hash", "content_sha256", "packs"],
			"additionalProperties": false
		},
		"rng": {"type": "object", "properties": {"seed": {"type": "string"}, "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}, "required": ["seed", "counters"], "additionalProperties": false},
		"clock": {"type": "object", "properties": {"seconds": {"type": "number", "minimum": 0}, "travel_days": {"type": "number", "minimum": 0}}, "required": ["seconds", "travel_days"], "additionalProperties": false},
		"fleet": {
			"type": "object",
			"properties": {
				"credits": {"type": "integer", "minimum": -2147483647, "maximum": 2147483647},
				"missiles": {"type": "integer", "minimum": 0, "maximum": 2147483647},
				"ships": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "integer", "minimum": 1}, "chassis": {"type": "string"}, "flagship": {"type": "boolean"}, "hull_hp": {"type": "number"}, "formation": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "mounts": {"type": "object", "additionalProperties": {"type": "string"}}}, "required": ["id", "chassis", "flagship", "hull_hp", "formation", "mounts"]}},
				"equipment": {"type": "object", "additionalProperties": {"type": "object", "properties": {"uid": {"type": "string"}, "equipment_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}}, "required": ["uid", "equipment_id", "rank"]}},
				"squadrons": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "integer", "minimum": 1}, "members": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "overrides": {"type": "array", "items": {"type": "integer", "minimum": 1}}}, "required": ["id", "members", "overrides"]}},
				"next_ship_id": {"type": "integer", "minimum": 1}, "next_equipment_id": {"type": "integer", "minimum": 1},
				"research": {"type": "object"}, "pending": {"type": "boolean"}, "ended": {"type": "boolean"}, "completed": {"type": "boolean"},
				"pending_encounter": {"type": "object"}, "battle_reserves": {"type": "object"}
			},
			"required": ["credits", "missiles", "ships", "equipment", "squadrons", "next_ship_id", "next_equipment_id", "research", "pending", "ended", "completed", "pending_encounter", "battle_reserves"],
			"additionalProperties": false
		},
		"travel": {"type": "object"}, "galaxy": {"type": "object"}, "sites": {"type": "object"},
		"factions": {"type": "object"}, "actors": {"type": "object"}, "quests": {"type": "object"},
		"pressures": {"type": "object"}, "director": {"type": "object"}, "stats": {"type": "object"},
		"chronicle": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "integer", "minimum": 1}, "type": {"type": "string", "minLength": 1}, "seconds": {"type": "number", "minimum": 0}, "data": {"type": "object"}}, "required": ["id", "type", "seconds", "data"], "additionalProperties": false}}, "vars": {"type": "object"}
	},
	"required": ["meta", "rng", "clock", "fleet", "travel", "galaxy", "sites", "factions", "actors", "quests", "pressures", "director", "stats", "chronicle", "vars"],
	"additionalProperties": false
}
